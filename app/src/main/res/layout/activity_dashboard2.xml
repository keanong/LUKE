<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/Dashboard2linearLayout1"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/colorPrimaryDark"
    android:orientation="vertical"
    android:weightSum="10">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-5dp"
        android:background="@color/colorPrimaryDark"
        android:layout_weight="1">

    </LinearLayout>

    <LinearLayout
        android:id="@+id/Dashboard2UnreadMsgLinearLayout"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:layout_weight="1"
        android:background="@color/colorPrimaryDark">

        <Button
            android:id="@+id/Dashboard2UnreadMsgtextBtn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="5dp"
            android:layout_weight="1.0"
            android:background="@drawable/button_fail_style"
            android:gravity="center"
            android:onClick="Dashboard2UnreadMsgtextClick"
            android:text="@string/buttontext_unreadmsg"
            android:textColor="#ffffff"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:layout_weight="1"
        android:background="@color/colorPrimaryDark"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="3">

        <TextView
            android:id="@+id/Dashboard2text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="5dp"
            android:layout_weight="1.0"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:gravity="left|center"
            android:minLines="1"
            android:singleLine="false"
            android:text="CN No."
            android:textColor="#ffffff"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/txtDashboard2Input"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginBottom="1dp"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="1dp"
            android:layout_marginTop="1dp"
            android:layout_weight="2.0"
            android:background="@drawable/txtbox_def"
            android:focusable="true"
            android:imeOptions="actionGo"
            android:inputType="textCapCharacters"
            android:paddingLeft="10dp"
            android:singleLine="true"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/Dashboard2ListviewLinearLayout"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:layout_marginTop="-3dp"
        android:layout_weight="9"
        android:background="#fff"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:weightSum="1">

        <ListView
            android:id="@+id/listView"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:choiceMode="singleChoice"
            android:clickable="true" />
    </LinearLayout>

</LinearLayout>