<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/bg_light_blue"
    android:orientation="vertical"
    android:weightSum="10">

    <ViewSwitcher
        android:id="@+id/viewSwitcher"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:layout_weight="8.4">

        <GridView
            android:id="@+id/gridGallery"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginBottom="-10dp"
            android:layout_marginLeft="-10dp"
            android:layout_marginRight="-10dp"
            android:layout_marginTop="-10dp"
            android:horizontalSpacing="-15dp"
            android:numColumns="3"
            android:padding="0sp"
            android:verticalSpacing="-15dp"
            tools:listitem="@layout/gallery_item"></GridView>

        <ImageView
            android:id="@+id/imgSinglePick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:src="@drawable/no_media" />
    </ViewSwitcher>

    <LinearLayout
        android:id="@+id/llBottomContainer"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="1sp"
        android:layout_weight="0.8">

        <Button
            android:id="@+id/btnGalleryPickMul"
            android:textColor="@android:color/white"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:background="@drawable/button_normal_style"
            android:text="@string/buttontext_selectfromgallery"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_margin="1dp" />

        <!--<Button
            android:id="@+id/btnGalleryPickMul"
            android:textColor="@android:color/white"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:background="@color/menu_bg"
            android:text="@string/buttontext_selectfromgallery"
            android:textStyle="bold"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="1dp" />-->
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llBottomContainer2"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:padding="1dp"
        android:weightSum="2"
        android:layout_weight="0.8">

        <Button
            android:id="@+id/btnGallery_OK"
            android:textColor="@android:color/white"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:background="@drawable/button_normal_style"
            android:text="@string/buttontext_ok"
            android:layout_weight="2"
            android:onClick="btnOKClick"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_margin="1dp" />

        <!--<Button
            android:id="@+id/btnGallery_OK"
            android:textColor="@android:color/white"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:background="@color/menu_bg"
            android:text="@string/buttontext_ok"
            android:layout_weight="2"
            android:onClick="btnOKClick"
            android:textStyle="bold"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="1dp" />-->
    </LinearLayout>

</LinearLayout>