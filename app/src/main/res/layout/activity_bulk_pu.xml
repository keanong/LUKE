<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:id="@+id/linearLayout1"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical" xmlns:android="http://schemas.android.com/apk/res/android"
    android:weightSum="10"
    android:background="#ffffffff">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="top"
        android:background="#ffffffff"
        android:weightSum="3">

        <TextView android:id="@+id/lblIsDefaultVRPpage"
            android:layout_height="2dp"
            android:layout_width="2dp"
            android:visibility="gone"></TextView>

        <TextView
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:text="@string/lblentry"
            android:id="@+id/lblBulkPickUpMANUALENTRY"
            android:layout_marginLeft="5dp"
            android:textSize="14sp"
            android:textColor="#040404"
            android:textStyle="bold"
            android:layout_weight="0.5"
            android:gravity="center_vertical"
            android:focusable="false"
            android:layout_marginRight="0.5dp" />
        <EditText
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:id="@+id/txtBulkPickUpMANUALENTRY"
            android:singleLine="true"
            android:paddingLeft="10dp"
            android:background="@drawable/txtbox_def"
            android:textSize="16sp"
            android:layout_gravity="bottom"
            android:layout_margin="1dp"
            android:textStyle="bold"
            android:layout_weight="1.5"
            android:imeOptions="actionGo"
            android:inputType="textCapCharacters"
            android:focusable="true">
        </EditText>
        <Button
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:text="@string/buttontext_enter"
            android:id="@+id/btnBulkPickUpENTER"
            android:layout_weight="1"
            android:textStyle="bold"
            android:focusable="false"
            android:onClick="btnBulkPickUpENTERClick"
            android:background="@drawable/button_normal_style"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:layout_margin="1dp" />
        <!--<Button
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="@string/buttontext_enter"
            android:id="@+id/btnBulkPickUpENTER"
            android:layout_weight="1"
            android:textStyle="bold"
            android:focusable="false"
            android:onClick="btnBulkPickUpENTERClick"
            android:background="@color/menu_bg"
            android:textColor="#ffffff"
            android:layout_marginLeft="0.5dp"
            android:layout_marginRight="0.5dp" />-->
    </LinearLayout>
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5"
        android:layout_gravity="top"
        android:background="#ffffffff"
        android:weightSum="3"
        android:gravity="right">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="@string/lbl_clicktodelete"
            android:id="@+id/lblBulkPickUpMISC"
            android:layout_marginRight="2dp"
            android:textSize="14sp"
            android:textColor="#040404"
            android:textStyle="bold"
            android:focusable="false"
            android:gravity="center_vertical" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5"
        android:layout_gravity="top"
        android:background="#ffffffff"
        android:weightSum="3">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="ID:"
            android:id="@+id/lblBulkPickUpID"
            android:textSize="14sp"
            android:textColor="#040404"
            android:textStyle="bold"
            android:layout_marginLeft="5dp"
            android:focusable="false"
            android:gravity="center_vertical" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="IDX|USERNAME"
            android:id="@+id/lblBulkPickUpIDval"
            android:textSize="14sp"
            android:textColor="#040404"
            android:textStyle="bold"
            android:layout_marginLeft="5dp"
            android:focusable="false"
            android:gravity="center_vertical" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="COUNT"
            android:id="@+id/lblBulkPickUpCOUNT"
            android:textSize="14sp"
            android:textColor="#ffff0000"
            android:textStyle="bold"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:focusable="false"
            android:gravity="center_vertical" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="7"
        android:layout_gravity="top"
        android:background="#ffffffff"
        android:weightSum="3">

        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:focusableInTouchMode="true"
            android:focusable="false">
            <ListView
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:id="@+id/listView"
                android:choiceMode="singleChoice"
                android:clickable="true"
                android:focusable="false"/>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="top"
        android:background="#ffffffff"
        android:weightSum="3">

        <Button
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:text="@string/buttontext_cancel"
            android:id="@+id/btnBulkPickUpCANCEL"
            android:onClick="btnBulkPickUpCANCELClick"
            android:textStyle="bold"
            android:layout_weight="1"
            android:focusable="false"
            android:textColor="#ffffff"
            android:background="@drawable/button_normal_style"
            android:textSize="18sp"
            android:layout_margin="1dp" />
        <!--<Button
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:text="@string/buttontext_cleardata"
            android:id="@+id/btnBulkPickUpCLEARALL"
            android:onClick="btnBulkPickUpCLEARALLClick"
            android:layout_weight="1"
            android:textStyle="bold"
            android:focusable="false"
            android:textColor="#ffffff"
            android:background="@drawable/button_normal_style"
            android:textSize="18sp"
            android:layout_margin="1dp" />-->

        <Button
            android:id="@+id/btnBulkPickUpSCAN"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_margin="1dp"
            android:layout_weight="1"
            android:background="@drawable/button_normal_style"
            android:focusable="false"
            android:onClick="btnBulkPickUpSCANClick"
            android:text="@string/action_scan"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:text="@string/buttontext_submit"
            android:id="@+id/btnBulkPickUpSUBMIT"
            android:onClick="btnBulkPickUpSUBMITClick"
            android:textStyle="bold"
            android:layout_weight="1"
            android:focusable="false"
            android:textColor="#ffffff"
            android:background="@drawable/button_normal_style"
            android:textSize="18sp"
            android:layout_margin="1dp" />

        <!--<Button
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:text="@string/buttontext_cancel"
            android:id="@+id/btnBulkPickUpCANCEL"
            android:onClick="btnBulkPickUpCANCELClick"
            android:textStyle="bold"
            android:layout_weight="1"
            android:focusable="false"
            android:textColor="#ffffff"
            android:background="@color/menu_bg"
            android:layout_marginRight="0.5dp"
            android:layout_marginLeft="1dp" />
        <Button
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:text="@string/buttontext_cleardata"
            android:id="@+id/btnBulkPickUpCLEARALL"
            android:onClick="btnBulkPickUpCLEARALLClick"
            android:layout_weight="1"
            android:textStyle="bold"
            android:focusable="false"
            android:textColor="#ffffff"
            android:layout_marginRight="0.5dp"
            android:background="@color/menu_bg"
            android:layout_marginLeft="0.5dp" />
        <Button
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:text="@string/buttontext_submit"
            android:id="@+id/btnBulkPickUpSUBMIT"
            android:onClick="btnBulkPickUpSUBMITClick"
            android:textStyle="bold"
            android:layout_weight="1"
            android:focusable="false"
            android:textColor="#ffffff"
            android:background="@color/menu_bg"
            android:layout_marginRight="0.5dp"
            android:layout_marginLeft="0.5dp" />-->
    </LinearLayout>
</LinearLayout>
