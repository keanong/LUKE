<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dialog_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingBottom="5dp"
    android:paddingLeft="5dp"
    android:paddingRight="5dp"
    android:paddingTop="5dp"
    android:weightSum="10">

    <LinearLayout
        android:id="@+id/base"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="7"
        android:background="@drawable/gradient_bg_blue"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textViewPeer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="@string/waitconnecting"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textColor="@color/White"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lbltel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:layout_margin="10dp"
            android:text="63761830"
            android:textColor="@color/White"
            android:textSize="25sp"
            android:textStyle="bold"
            />

        <TextView
            android:id="@+id/textViewCallState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Call state"
            android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:background="@drawable/roundcornerbottom_background"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="5">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:weightSum="3"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"></LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center">

                <ImageView
                    android:id="@+id/ibtnSpeaker"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:onClick="speakermode"
                    android:src="@mipmap/icons8_speaker"
                    android:visibility="visible" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center|bottom">

                <ImageView
                    android:id="@+id/ibtnBT"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_action_bluetooth_audio"
                    android:layout_margin="10dp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">



        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <ImageView
                android:id="@+id/ibtnHangup"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:onClick="hangupCall"
                android:src="@mipmap/icons8_end_call"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <ImageView
                android:id="@+id/ibtnInfo"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:onClick="viewInfo"
                android:src="@mipmap/ic_action_info"
                android:visibility="gone" />

        </LinearLayout>

        <Button
            android:id="@+id/buttonAccept"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="acceptCall"
            android:text="Accept"
            android:visibility="gone" />

        <Button
            android:id="@+id/buttonHangup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="hangupCall"
            android:text="Reject"
            android:visibility="gone" />

        <!--<Button
            android:id="@+id/buttonShowPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="showPreview"
            android:text="@+string/show_preview"
            android:visibility="gone" />

        <SurfaceView
            android:id="@+id/surfacePreviewCapture"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight=".50"
            android:visibility="gone" />

        <SurfaceView
            android:id="@+id/surfaceIncomingVideo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />-->

    </LinearLayout>

</LinearLayout>