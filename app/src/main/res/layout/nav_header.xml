<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="250dp"
    android:background="@color/colorPrimaryDark"
    android:gravity="bottom|center"
    android:orientation="vertical"
    android:paddingBottom="10dp"
    android:paddingTop="40dp"
    android:weightSum="5">

    <LinearLayout
        android:id="@+id/LLsettings00"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lukeversion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Version"
            android:textColor="@color/White"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/LLsettings0"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgProfilePix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:paddingTop="5dp"
            android:adjustViewBounds="true"
            android:src="@mipmap/ic_acct_w_512" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/LLsettings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/couriername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NAME"
            android:textColor="@color/White"
            android:textSize="16sp" />

        <!--<ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_action_settings_white"/>-->

    </LinearLayout>

</LinearLayout>