<LinearLayout android:id="@+id/updatecod_list_linearLayout1"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:weightSum="10"
    android:background="#ffffffff">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="9"
        android:layout_gravity="top"
        android:background="#ffffff"
        android:orientation="horizontal">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listview"
            android:scrollbars="vertical"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            />


    </LinearLayout>


    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="top"
        android:background="#ffffff"
        android:weightSum="2"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnupdatecod_listCancel"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:text="@string/buttontext_back"
            android:layout_weight="1"
            android:onClick="btnCancelClick"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:background="@color/menu_bg"
            android:layout_marginRight="0.5dp"
            android:layout_marginLeft="1dp" />

        <!--<Button
            android:id="@+id/btnUpdateCODListNext"
            android:layout_width="0sp"
            android:layout_height="fill_parent"
            android:text="@string/buttontext_next"
            android:layout_weight="1"
            android:onClick="btnNextClick"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:background="@color/menu_bg"
            android:layout_marginLeft="0.5sp"
            android:layout_marginRight="1sp" />-->

        <Button
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:id="@+id/btnUpdateCODListSubmit"
            android:layout_weight="1"
            android:text="@string/buttontext_submit"
            android:onClick="btnSubmitClick"
            android:layout_gravity="top"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@color/menu_bg"
            android:layout_marginLeft="0.5dp"
            android:layout_marginRight="1dp"
            android:visibility="visible"/>
    </LinearLayout>

</LinearLayout>