<LinearLayout android:id="@+id/DriverPointlinearLayout1"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:weightSum="10"
    android:background="#ffffffff">

    <LinearLayout
        android:id="@+id/DriverPointDailyLinearLayout"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#ffffff">

        <Button
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="1.0"
            android:text="@string/pointsummarydatefromto2"
            android:id="@+id/DriverPointSummaryBtn"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:gravity="center"
            android:textStyle="bold"
            android:background="@drawable/button_normal_style"
            android:layout_margin="1dp"
            android:onClick="getSummary" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/DriverPointDailyBlankLinearLayout0"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="0.1"
        android:weightSum="4"
        android:background="#ffffff"
        android:orientation="horizontal">

    </LinearLayout>

    <LinearLayout
        android:id="@+id/DriverPointDailySummaryLinearLayout"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5"
        android:layout_gravity="top"
        android:background="#ffffff">

        <TextView
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:id="@+id/lbldriverpointdaily"
            android:text="@string/dailypoint"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#ff0000"
            android:gravity="center" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/DriverPointDailyBlankLinearLayout2"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="0.1"
        android:weightSum="4"
        android:background="#ffffff"
        android:orientation="horizontal"
        >

    </LinearLayout>

    <LinearLayout
        android:id="@+id/DriverPointDailyListviewLinearLayout"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="8.3"
        android:layout_gravity="top"
        android:background="#ffffffff"
        android:weightSum="1"
        android:focusableInTouchMode="false"
        android:focusable="false">

        <ExpandableListView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:id="@+id/expListView"
            android:choiceMode="singleChoice"
            android:clickable="true"
            android:transcriptMode="disabled"
            />
    </LinearLayout>

</LinearLayout>