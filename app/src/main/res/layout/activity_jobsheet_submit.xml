<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:id="@+id/linearLayout1"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical" xmlns:android="http://schemas.android.com/apk/res/android"
    android:weightSum="10"
    android:background="#ffffffff">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="top|center"
        android:background="@color/colorPrimaryDark"
        android:weightSum="3">

        <TextView
            android:id="@+id/lbljsmode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"></TextView>

        <TextView
            android:id="@+id/lbldesc"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text=""
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:textStyle="bold"></TextView>

    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="top"
        android:background="#ffffffff"
        android:weightSum="3">

        <TextView android:id="@+id/lblIsDefaultVRPpage"
            android:layout_height="2dp"
            android:layout_width="2dp"
            android:visibility="gone"></TextView>

        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:id="@+id/lbljobsheetSubmitIsHomesUser"
            />

        <TextView
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:text="@string/lblentry"
            android:id="@+id/lblJobsheetSubmitMANUALENTRY"
            android:layout_marginLeft="5dp"
            android:textSize="14sp"
            android:textColor="#040404"
            android:textStyle="bold"
            android:layout_weight="0.5"
            android:gravity="center_vertical"
            android:focusable="false"
            android:layout_marginRight="0.5dp" />

        <EditText
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:id="@+id/txtJobsheetSubmitMANUALENTRY"
            android:singleLine="true"
            android:paddingLeft="10dp"
            android:background="@drawable/txtbox_def"
            android:textSize="16sp"
            android:layout_gravity="bottom"
            android:textStyle="bold"
            android:layout_weight="1.5"
            android:imeOptions="actionGo"
            android:inputType="textCapCharacters"
            android:focusable="true"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="1dp"
            android:layout_marginLeft="0.5dp"
            android:layout_marginRight="0.5dp">
        </EditText>

        <Button
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:text="@string/buttontext_enter"
            android:id="@+id/btnJobsheetSubmitENTER"
            android:layout_weight="1"
            android:textStyle="bold"
            android:focusable="false"
            android:onClick="btnJobsheetSubmitENTERClick"
            android:textColor="#ffffff"
            android:background="@drawable/button_normal_style"
            android:textSize="18sp"
            android:layout_margin="1dp" />

    </LinearLayout>
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5"
        android:background="#ffffffff"
        android:weightSum="3"
        android:gravity="right"
        android:layout_gravity="top">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="@string/lbl_clicktodelete"
            android:id="@+id/lblJobsheetSubmitMISC"
            android:layout_marginRight="1dp"
            android:textSize="14sp"
            android:textColor="#040404"
            android:textStyle="bold"
            android:focusable="false"
            android:gravity="center_vertical" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5"
        android:layout_gravity="top"
        android:background="#ffffffff"
        android:weightSum="3">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="ID:"
            android:id="@+id/lblJobsheetSubmitID"
            android:textSize="14sp"
            android:textColor="#040404"
            android:textStyle="bold"
            android:layout_marginLeft="5dp"
            android:focusable="false"
            android:gravity="center_vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="IDX|USERNAME"
            android:id="@+id/lblJobsheetSubmitIDval"
            android:textSize="14sp"
            android:textColor="#040404"
            android:textStyle="bold"
            android:layout_marginLeft="5dp"
            android:focusable="false"
            android:gravity="center_vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="COUNT"
            android:id="@+id/lblJobsheetSubmitCOUNT"
            android:textSize="14sp"
            android:textColor="#ffff0000"
            android:textStyle="bold"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:focusable="false"
            android:gravity="center_vertical" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="6"
        android:layout_gravity="top"
        android:background="#ffffffff"
        android:weightSum="3">

        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:focusableInTouchMode="true"
            android:focusable="false">

            <ListView
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:id="@+id/listView"
                android:choiceMode="singleChoice"
                android:clickable="true"
                android:focusable="false"/>

        </RelativeLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="top"
        android:background="#ffffffff"
        android:weightSum="3">

        <Button
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:text="@string/buttontext_cancel"
            android:id="@+id/btnJobsheetSubmitCANCEL"
            android:onClick="btnJobsheetSubmitCANCELClick"
            android:textStyle="bold"
            android:layout_weight="1"
            android:focusable="false"
            android:textColor="#ffffff"
            android:background="@drawable/button_normal_style"
            android:layout_margin="1dp"
            android:textSize="18sp"
            android:layout_gravity="top" />

        <Button
            android:id="@+id/btnJobsheetSCAN"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_margin="1dp"
            android:layout_weight="1"
            android:background="@drawable/button_normal_style"
            android:focusable="false"
            android:onClick="btnJobsheetSCANClick"
            android:text="@string/action_scan"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:text="@string/buttontext_submit"
            android:id="@+id/btnJobsheetSubmitSUBMIT"
            android:onClick="btnJobsheetSubmitSUBMITClick"
            android:textStyle="bold"
            android:layout_weight="1"
            android:focusable="false"
            android:textColor="#ffffff"
            android:background="@drawable/button_normal_style"
            android:layout_margin="1dp"
            android:textSize="18sp"
            android:layout_gravity="top" />

    </LinearLayout>

</LinearLayout>
