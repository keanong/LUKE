<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/linearLayout1"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/list_selector_white"
    android:minHeight="30dp"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/LLupdatecodMain"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lblCnInvNo"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:gravity="left|center"
            android:text="Job #"
            android:textAllCaps="true"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblJobsIDX"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lblInvoiceIDX"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lblAIDX"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/lblStatusCodesIDX"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lblImageString"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/LLupdatecodTotalValueTxt"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">

        <TextView
            android:id="@+id/lblupdatecodTotalValueTxt"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_marginLeft="5dp"
            android:layout_weight="1"
            android:gravity="left|center"
            android:text="AMOUNT"
            android:textAllCaps="true"
            android:textColor="#ffff0000"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/LLupdatecodButtons"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="4">


        <Button
            android:id="@+id/btnupdatecodcash"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_marginBottom="0.5dp"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="0.5dp"
            android:layout_marginTop="0.5dp"
            android:layout_weight="1"
            android:background="@drawable/button_normal_style"
            android:text="@string/cash"
            android:textAllCaps="true"
            android:textColor="#ffffff"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnupdatecodcheque"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_marginBottom="0.5dp"
            android:layout_marginLeft="0.5dp"
            android:layout_marginRight="0.5dp"
            android:layout_marginTop="0.5dp"
            android:layout_weight="1"
            android:background="@drawable/button_normal_style"
            android:text="@string/cheque"
            android:textAllCaps="true"
            android:textColor="#ffffff"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnupdatecodnc"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_marginBottom="0.5dp"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="0.5dp"
            android:layout_marginTop="0.5dp"
            android:layout_weight="1"
            android:background="@drawable/button_normal_style"
            android:text="@string/notcollected"
            android:textAllCaps="true"
            android:textColor="#ffffff"
            android:textStyle="bold" />


        <ImageButton
            android:id="@+id/btnupdatecodRefresh"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_marginBottom="0.5dp"
            android:layout_marginLeft="0.5dp"
            android:layout_marginRight="1dp"
            android:layout_marginTop="0.5dp"
            android:layout_weight="1"
            android:background="@drawable/button_normal_style"
            android:src="@mipmap/ic_action_refresh" />


    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="1dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/v3"
            android:layout_width="fill_parent"
            android:layout_height="2dp"
            android:background="#ff000000"></View>

    </LinearLayout>

</LinearLayout>