<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff"
    tools:context=".inventory.InventorySummaryActivity">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:weightSum="10"
        tools:ignore="MissingConstraints">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:background="@drawable/tabstyle_base_black_bg_white"
            android:orientation="horizontal"
            android:weightSum="3">

            <TextView
                android:id="@+id/lblBatch_ID"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lblInvMainSubmitIsHomesUser"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lblIsDefaultVRPpage"
                android:layout_width="2dp"
                android:layout_height="2dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lblInvMainUserIDX"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lblInvMainDriverIDX"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lblLog"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/inventory_summary_submit_clause"
                android:textColor="@color/menu_red"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/LLInvMainBlank"
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:layout_weight="8"
            android:background="#ffffffff"
            android:orientation="vertical"
            android:visibility="visible"
            android:weightSum="7">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="false"
                android:focusableInTouchMode="true">

                <ListView
                    android:id="@+id/lvInvSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:choiceMode="singleChoice"
                    android:clickable="false"></ListView>

            </RelativeLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:background="#ffffffff"
            android:weightSum="2">

            <Button
                android:id="@+id/btnInvSummaryCANCEL"
                android:layout_width="0dp"
                android:layout_height="fill_parent"
                android:layout_margin="1dp"
                android:layout_weight="1"
                android:background="@drawable/button_normal_style"
                android:focusable="false"
                android:onClick="btnInvSummaryCANCEL_Click"
                android:text="@string/buttontext_cancel"
                android:textColor="#ffffff"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnInvSummary"
                android:layout_width="0dp"
                android:layout_height="fill_parent"
                android:layout_margin="1dp"
                android:layout_weight="1"
                android:background="@drawable/button_ok_style"
                android:focusable="false"
                android:onClick="btnInvSummary_Click"
                android:text="@string/buttontext_submit"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />


        </LinearLayout>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>