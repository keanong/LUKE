<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimaryDark"
    tools:context=".inventory.InventoryMainActivity">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:weightSum="10"
        tools:ignore="MissingConstraints">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:background="@color/White"
            android:orientation="horizontal"
            android:weightSum="3">

            <TextView
                android:id="@+id/lblIsDefaultVRPpage"
                android:layout_width="2dp"
                android:layout_height="2dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lblInvMainSubmitIsHomesUser"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lblInvMainUserIDX"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lblInvMainDriverIDX"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:visibility="gone" />

            <EditText
                android:id="@+id/txtInvMainBarcodeMANUALENTRY"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="2"
                android:background="@drawable/txtbox_def"
                android:focusable="true"
                android:gravity="center"
                android:imeOptions="actionGo"
                android:hint="@string/batch_id"
                android:inputType="textCapCharacters"
                android:singleLine="true"
                android:textSize="16sp"
                android:textStyle="bold"></EditText>

            <Button
                android:id="@+id/btnInvMainBarcodeSubmitENTER"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/button_normal_style"
                android:focusable="false"
                android:onClick="btnInvMainBarcodeSubmitENTER_Click"
                android:text="@string/buttontext_enter"
                android:textColor="#ffffff"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/LLInvMainBlank"
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:layout_weight="8"
            android:background="#ffffffff"
            android:orientation="vertical"
            android:visibility="visible"
            android:weightSum="7">

            <TextView
                android:id="@+id/lblMainBlankLog"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text=""
                android:textColor="@color/menu_red"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblinstructions"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/invstart"
                android:textColor="@color/menu_red"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ListView
                android:id="@+id/lvInvMainBatchID"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="5"
                android:layout_margin="1dp"
                android:choiceMode="singleChoice"
                android:clickable="false"></ListView>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/LLInvMainShown"
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:layout_weight="8"
            android:background="#ffffff"
            android:orientation="vertical"
            android:visibility="gone"
            android:weightSum="8">

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="0dp"
                android:layout_gravity="center|top"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lblBatch_ID"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/menu_red"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="0dp"
                android:layout_gravity="center|top"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnInvVerify"
                    android:layout_width="0dp"
                    android:layout_height="fill_parent"
                    android:layout_weight="1"
                    android:background="@drawable/button_tabstyle_selected"
                    android:focusable="false"
                    android:onClick="btnInvVerify_Click"
                    android:text="@string/invtally"
                    android:textColor="#ffffff"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="visible" />

                <Button
                    android:id="@+id/btnInvBal"
                    android:layout_width="0dp"
                    android:layout_height="fill_parent"
                    android:layout_weight="1"
                    android:background="@drawable/button_tabstyle_unselected"
                    android:focusable="false"
                    android:onClick="btnInvBal_Click"
                    android:text="@string/invbal"
                    android:textColor="#ffffff"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="visible" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/LLInvMainTally"
                android:layout_width="fill_parent"
                android:layout_height="0dp"
                android:layout_gravity="center"
                android:layout_weight="6"
                android:background="#ffffffff"
                android:orientation="vertical"
                android:visibility="visible"
                android:weightSum="7">

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#ffffffff"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblInvMainTallylog"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text=""
                        android:textColor="@color/menu_red"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#ffffffff"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblInvMainTallyStockCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/stockcodestart"
                        android:textColor="@color/menu_red"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/LLInvMainTallyQty"
                    android:layout_width="fill_parent"
                    android:layout_height="0dp"
                    android:layout_gravity="center"
                    android:layout_margin="1dp"
                    android:layout_weight="5"
                    android:background="#ffffffff"
                    android:orientation="vertical"
                    android:visibility="visible"
                    android:weightSum="5">

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="0dp"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:background="#ffffffff"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:visibility="visible">

                        <TextView
                            android:id="@+id/lblInvMainTallyQty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="4dp"
                            android:gravity="center"
                            android:text="@string/stockcount"
                            android:textColor="@color/menu_red"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/lblInvMainTallyQtyVBal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="2dp"
                            android:gravity="center"
                            android:text="0"
                            android:textColor="@color/menu_red"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/lblInvMainTallyQtySlash"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="2dp"
                            android:gravity="center"
                            android:text="/"
                            android:textColor="@color/menu_red"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/lblInvMainTallyQtyBal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="8"
                            android:textColor="@color/menu_red"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="0dp"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:background="#ffffffff"
                        android:orientation="horizontal"
                        android:visibility="visible"
                        android:weightSum="3">

                        <Button
                            android:id="@+id/btnInvMainTallyQtyUndo"
                            android:layout_width="0dp"
                            android:layout_height="fill_parent"
                            android:layout_margin="1dp"
                            android:layout_weight="1"
                            android:background="@drawable/button_normal_style"
                            android:focusable="false"
                            android:onClick="btnInvMainTallyQtyUndo_Click"
                            android:text="@string/undo_text"
                            android:textColor="#ffffff"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/txtInvMainTallyQty"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/txtbox_def"
                            android:focusable="true"
                            android:gravity="center"
                            android:imeOptions="actionGo"
                            android:inputType="number|textNoSuggestions"
                            android:singleLine="true"
                            android:textSize="16sp"
                            android:textStyle="bold"></EditText>

                        <Button
                            android:id="@+id/btnInvMainTallyQtyAdd"
                            android:layout_width="0dp"
                            android:layout_height="fill_parent"
                            android:layout_margin="1dp"
                            android:layout_weight="1"
                            android:background="@drawable/button_normal_style"
                            android:focusable="false"
                            android:onClick="btnInvMainTallyQtyAdd_Click"
                            android:text="@string/taggingswitchOptionAdd"
                            android:textColor="#ffffff"
                            android:textSize="18sp"
                            android:textStyle="bold" />


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="0dp"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:background="#ffffffff"
                        android:orientation="horizontal"
                        android:visibility="visible"
                        android:weightSum="3">

                        <Button
                            android:id="@+id/btnInvMainTallyQtyReset"
                            android:layout_width="0dp"
                            android:layout_height="fill_parent"
                            android:layout_margin="1dp"
                            android:layout_weight="3"
                            android:background="@drawable/button_normal_style"
                            android:focusable="false"
                            android:onClick="btnInvMainTallyQtyReset_Click"
                            android:text="@string/reset_text"
                            android:textColor="#ffffff"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="0dp"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:background="#ffffffff"
                        android:orientation="vertical"
                        android:visibility="visible">


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="0dp"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:background="#ffffffff"
                        android:orientation="vertical"
                        android:visibility="visible">


                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/LLInvMainTallySR"
                    android:layout_width="fill_parent"
                    android:layout_height="0dp"
                    android:layout_gravity="center"
                    android:layout_margin="1dp"
                    android:layout_weight="5"
                    android:background="#ffffffff"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:weightSum="5">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:focusable="false"
                        android:focusableInTouchMode="true">

                        <ListView
                            android:id="@+id/lvInvMainTallySR"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentTop="true"
                            android:choiceMode="singleChoice"
                            android:clickable="false"></ListView>

                    </RelativeLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/LLInvMainBal"
                android:layout_width="fill_parent"
                android:layout_height="0dp"
                android:layout_gravity="center"
                android:layout_weight="6"
                android:background="#ffffffff"
                android:orientation="vertical"
                android:visibility="gone"
                android:weightSum="7">

                <!--<LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#ffffffff"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblInvMainBallog"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text=""
                        android:textColor="@color/menu_red"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>-->

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="0dp"
                    android:layout_gravity="center"
                    android:layout_margin="1dp"
                    android:layout_weight="7"
                    android:background="#ffffffff"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:focusable="false"
                        android:focusableInTouchMode="true">

                        <ListView
                            android:id="@+id/lvInvMainBal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentTop="true"
                            android:choiceMode="singleChoice"
                            android:clickable="false"></ListView>

                    </RelativeLayout>

                </LinearLayout>


            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:background="#ffffffff"
            android:weightSum="2">

            <Button
                android:id="@+id/btnInvMainCANCEL"
                android:layout_width="0dp"
                android:layout_height="fill_parent"
                android:layout_margin="1dp"
                android:layout_weight="1"
                android:background="@drawable/button_normal_style"
                android:focusable="false"
                android:onClick="btnInvMainCANCEL_Click"
                android:text="@string/buttontext_cancel"
                android:textColor="#ffffff"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnInvMainSummary"
                android:layout_width="0dp"
                android:layout_height="fill_parent"
                android:layout_margin="1dp"
                android:layout_weight="1"
                android:background="@drawable/button_disabled_style"
                android:focusable="false"
                android:onClick="btnInvMainSummary_Click"
                android:text="@string/buttontext_summarise"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />


        </LinearLayout>


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>