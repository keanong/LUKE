<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#ffffff"
    android:orientation="vertical"
    android:weightSum="10"
    tools:context="com.xdel.luke.AddressListNewActivity">

    <LinearLayout
        android:id="@+id/AddressListUnreadMsgLinearLayout"
        android:layout_width="fill_parent"
        android:layout_height="0sp"
        android:layout_gravity="top"
        android:layout_weight="1"
        android:background="@color/colorPrimaryDark"
        android:orientation="horizontal"
        android:weightSum="1">

        <Button
            android:id="@+id/AddressListUnreadMsgtextBtn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="5dp"
            android:layout_weight="1.0"
            android:background="@drawable/button_fail_style"
            android:gravity="center"
            android:onClick="AddressListUnreadMsgtextClick"
            android:text="@string/buttontext_unreadmsg"
            android:textColor="#ffffff"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0sp"
        android:layout_gravity="top"
        android:layout_weight="1"
        android:background="@color/colorPrimaryDark"
        android:weightSum="3">

        <TextView
            android:id="@+id/Addresslisttext"
            android:layout_width="0sp"
            android:layout_height="fill_parent"
            android:layout_marginLeft="5sp"
            android:layout_weight="1.0"
            android:gravity="left|center"
            android:minLines="1"
            android:singleLine="false"
            android:text="CN No."
            android:textColor="#ffffff"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/AddresslistInput"
            android:layout_width="0sp"
            android:layout_height="fill_parent"
            android:layout_margin="1dp"
            android:layout_weight="2.0"
            android:background="@drawable/txtbox_def"
            android:focusable="true"
            android:imeOptions="actionGo"
            android:inputType="textCapCharacters"
            android:paddingLeft="10dp"
            android:singleLine="true"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/LLDeliveryTabs"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:layout_weight="1"
        android:background="#ffffffff"
        android:gravity="center"
        android:weightSum="2">

        <Button
            android:id="@+id/btnlistall"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="bottom"
            android:layout_margin="1dp"
            android:layout_weight="1"
            android:background="@drawable/button_normal_style"
            android:text="@string/buttontext_listall"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="visible" />

        <Button
            android:id="@+id/btnlistpriority"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="bottom"
            android:layout_margin="1dp"
            android:layout_weight="1"
            android:background="@drawable/button_fail_style"
            android:text="@string/buttontext_listpriority"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="visible" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/AddressListListviewLinearLayout"
        android:layout_width="fill_parent"
        android:layout_height="0sp"
        android:layout_gravity="top"
        android:layout_marginTop="10sp"
        android:layout_weight="8"
        android:background="#ffffff"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:weightSum="1">

        <ListView
            android:id="@+id/listView"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:choiceMode="singleChoice"
            android:clickable="true" />

    </LinearLayout>

</LinearLayout>
