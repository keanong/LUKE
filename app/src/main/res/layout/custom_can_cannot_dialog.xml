<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/custom_dialog_bg"
    android:id="@+id/LLcustomCanCannotMain"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="left"
            android:paddingLeft="25dp"
            android:text=""
            android:textColor="@color/colorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"></TextView>

    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="5dp"
        android:id="@+id/LLcustomCanCannot_msg">

        <TextView
            android:id="@+id/txtview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="left|center"
            android:visibility="gone"
            android:textColor="@color/tickgreen"
            android:drawableLeft="@mipmap/ic_ok_black"
            android:text="asdasdasdasdasdadasdasdasdasdasdasdasdasdasdasdasdasdasdasdasdasdasdas"
            android:textStyle="bold"
            android:textSize="16sp"
            />

    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="right"
        android:id="@+id/LLcustom_ok">

        <TextView
            android:id="@+id/btnCustomCanCannotNo"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:layout_marginRight="10dp"
            android:gravity="center"
            android:text="@string/buttontext_NO"
            android:textStyle="bold"
            android:textSize="14sp"
            android:visibility="gone"
            android:textColor="@color/colorPrimary"
            />

        <TextView
            android:id="@+id/btnCustomCanCannotOK"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:gravity="center"
            android:text="@string/buttontext_ok"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/colorPrimary"
            />

    </LinearLayout>


</LinearLayout>