<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:id="@+id/DashboardSublinearLayout1"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:weightSum="10"
    android:background="#ffffffff" >

    <LinearLayout
        android:id="@+id/DashboardSubUnreadMsgLinearLayout"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="top"
        android:background="@color/colorPrimaryDark"
        android:weightSum="1"
        android:orientation="horizontal">

        <TextView android:id="@+id/lblIsDefaultVRPpage"
            android:layout_height="2dp"
            android:layout_width="2dp"
            android:visibility="gone"></TextView>

        <Button
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="1.0"
            android:text="@string/buttontext_unreadmsg"
            android:id="@+id/DashboardSubUnreadMsgtextBtn"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:gravity="center"
            android:textStyle="bold"
            android:background="@drawable/button_fail_style"
            android:layout_margin="5dp"
            android:onClick="DashboardSubUnreadMsgtextClick"
            />
    </LinearLayout>
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="top"
        android:background="@color/colorPrimaryDark"
        android:weightSum="3">
        <TextView
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="3"
            android:text="Address"
            android:id="@+id/DashboardSubtext"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:singleLine="false"
            android:minLines="1"
            android:textColor="#ffffff"
            android:textSize="17sp"
            android:gravity="left|center"
            android:textStyle="bold"
            android:focusable="false"
            android:focusableInTouchMode="false"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/DashboardSubListviewLinearLayout"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="9"
        android:layout_gravity="top"
        android:background="#ffffffff"
        android:weightSum="1"
        android:focusableInTouchMode="false"
        android:focusable="false"
        android:layout_marginTop="5dp">

        <ListView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:id="@+id/listView"
            android:choiceMode="singleChoice"
            android:clickable="true"
            android:focusableInTouchMode="false"
            android:focusable="false"/>
    </LinearLayout>

</LinearLayout>