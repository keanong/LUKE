<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/linearLayout1"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/list_selector_white"
    android:gravity="center"
    android:minHeight="50dp"
    android:orientation="horizontal"
    android:weightSum="6">

    <TextView
        android:id="@+id/lblRef"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="4"
        android:background="@drawable/rect_border_lrb"
        android:gravity="left|center"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:text="Reference No."
        android:textColor="#040404"
        android:textSize="16sp"
        android:textStyle="bold"
        android:typeface="sans" />

    <TextView
        android:id="@+id/lblexpected"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/rect_border_rb"
        android:gravity="center"
        android:text="0"
        android:textColor="#040404"
        android:textSize="17sp"
        android:textStyle="bold"
        android:typeface="sans" />

    <TextView
        android:id="@+id/lblactual"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/rect_border_rb"
        android:gravity="center"
        android:text="0"
        android:textColor="#040404"
        android:textSize="17sp"
        android:textStyle="bold"
        android:typeface="sans"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/LLtxtactual"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/rect_border_rb"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="visible">

        <EditText
            android:id="@+id/txtactual"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/rect_border_black"
            android:gravity="center"
            android:inputType="number|textNoSuggestions"
            android:digits="0123456789"
            android:text="0"
            android:textColor="#040404"
            android:textSize="17sp"
            android:textStyle="bold"
            android:typeface="sans" />

    </LinearLayout>


</LinearLayout>