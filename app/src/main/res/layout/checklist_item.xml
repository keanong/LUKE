<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/LLTypeRow1"
    android:layout_width="fill_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center_vertical"
    android:background="@drawable/edittextstyle_cash"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/LLDisplayText"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="visible"
        android:weightSum="5">

        <LinearLayout
            android:id="@+id/LLDisplayTextCBArea"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="top"
            android:layout_weight="0.5"
            android:gravity="top">

            <CheckBox
                android:id="@+id/cbMD"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:buttonTint="@color/menu_bg"
                android:textSize="16sp"
                android:visibility="visible" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4.5"
            android:gravity="top|left|center_vertical">

            <TextView
                android:id="@+id/lblText"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="2dp"
                android:layout_marginBottom="2dp"
                android:text="lblText"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>


    <LinearLayout
        android:id="@+id/LLOthers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="50dp"
        android:orientation="horizontal"
        android:weightSum="5">

        <LinearLayout
            android:id="@+id/LLOthersCBArea"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.5"
            android:gravity="top"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/cbMD2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/menu_bg"
                android:textSize="16sp"
                android:visibility="visible" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_marginBottom="5dp"
            android:layout_weight="4.5"
            android:gravity="top|left"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/cb"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="2dp"
                android:buttonTint="@color/menu_bg"
                android:textSize="16sp"
                android:visibility="visible" />

            <TextView
                android:id="@+id/lblValue"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="2dp"
                android:layout_marginBottom="2dp"
                android:text="lblValue"
                android:textColor="#000000"
                android:textSize="16sp"
                android:visibility="visible" />

            <!--original location for textbox-->

            <RadioGroup
                android:id="@+id/rg1"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginRight="2dp"
                android:orientation="vertical"
                android:visibility="visible" />

            <LinearLayout
                android:id="@+id/LLCheckbox"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="2dp"
                android:orientation="vertical"
                android:visibility="visible" />

            <LinearLayout
                android:id="@+id/LLDateTxtB"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginLeft="3dp"
                android:gravity="left|center_vertical"
                android:orientation="horizontal"
                android:visibility="visible">

                <EditText
                    android:id="@+id/txtdd"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:hint="@string/cl_dd"
                    android:inputType="number"
                    android:maxLength="2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text=" - " />

                <EditText
                    android:id="@+id/txtmm"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:hint="@string/cl_mm"
                    android:inputType="number"
                    android:maxLength="2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text=" - " />

                <EditText
                    android:id="@+id/txtyyyy"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:hint="@string/cl_yyyy"
                    android:inputType="number"
                    android:maxLength="4" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/LLDate"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_gravity="center"
                android:layout_marginLeft="3dp"
                android:gravity="left|center_vertical"
                android:orientation="horizontal"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/imgbtnDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_action_date" />

                <TextView
                    android:id="@+id/lblDate"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:gravity="center_vertical"
                    android:text="1/3/2017"
                    android:textColor="#000000"
                    android:textSize="16sp" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_action_arrow_back"
                    android:visibility="visible" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clicktochange"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:visibility="visible" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/LLDateTime"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_gravity="center"
                android:layout_marginLeft="3dp"
                android:gravity="left|center_vertical"
                android:orientation="horizontal"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/imgbtnDateTimeTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_action_time" />

                <TextView
                    android:id="@+id/lblDateTimeTime"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:gravity="center_vertical"
                    android:text="1/3/2017"
                    android:textColor="#000000"
                    android:textSize="16sp" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_action_arrow_back"
                    android:visibility="visible" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clicktochange"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:visibility="visible" />

            </LinearLayout>

            <!--original location for LLPhoto-->

            <LinearLayout
                android:id="@+id/LLIDVerification"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_gravity="center"
                android:layout_marginLeft="3dp"
                android:gravity="left|center_vertical"
                android:orientation="vertical"
                android:visibility="visible"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1.5"
                    android:gravity="left|center_vertical"
                    android:orientation="horizontal"
                    android:weightSum="7">

                    <TextView
                        android:id="@+id/lblIDVerificationVal"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                    <EditText
                        android:id="@+id/txtVerification"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:layout_weight="3.5"
                        android:background="@drawable/txtbox_def"
                        android:gravity="center"
                        android:hint="@string/cl_nricfin"
                        android:imeOptions="actionDone"
                        android:inputType="textCapCharacters"
                        android:maxLength="4"
                        android:singleLine="true"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/imgVerification"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="5dp"
                        android:layout_weight="0.5"
                        android:src="@mipmap/ic_action_failpu" />

                    <Button
                        android:id="@+id/btnVerification"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginBottom="10dp"
                        android:layout_weight="3"
                        android:text="@string/btnVerify"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="-3dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblenterlast"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/enterlast4char"
                        android:textColor="@color/menu_red"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Switch
                        android:id="@+id/yesnoIDVerificationSkip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_alignParentTop="true"
                        android:layout_marginRight="2dp"
                        android:layout_weight="1.5"
                        android:text="@string/lblunabletoverify"
                        android:textColor="@color/menu_red"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

            </LinearLayout>


            <LinearLayout
                android:id="@+id/LLIMEIVerification"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_gravity="center"
                android:layout_marginLeft="3dp"
                android:gravity="left|center_vertical"
                android:orientation="vertical"
                android:visibility="visible"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1.5"
                    android:gravity="left|center_vertical"
                    android:orientation="horizontal"
                    android:weightSum="7">

                    <TextView
                        android:id="@+id/lblIMEIVerificationVal"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/lblIMVCFirstFewChar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:gravity="right"
                        android:paddingRight="10dp"
                        android:text=""
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/txtIMEIVerification"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:layout_weight="3.5"
                        android:background="@drawable/txtbox_def"
                        android:gravity="center"
                        android:hint="@string/cl_imei"
                        android:imeOptions="actionDone"
                        android:inputType="textCapCharacters"
                        android:maxLength="4"
                        android:singleLine="true"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/imgIMVCVerification"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="5dp"
                        android:layout_weight="0.5"
                        android:src="@mipmap/ic_action_failpu" />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="-3dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnVerificationIMEI"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginBottom="10dp"
                        android:layout_weight="3"
                        android:text="@string/btnVerify"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/LLUpdatePieces"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_gravity="center"
                android:layout_marginLeft="3dp"
                android:gravity="left|center_vertical"
                android:orientation="horizontal"
                android:visibility="visible"
                android:weightSum="4">

                <EditText
                    android:id="@+id/txtLabelUpdatePiecesVal"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="3dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginRight="3dp"
                    android:layout_marginBottom="1dp"
                    android:layout_weight="4"
                    android:background="@drawable/txtbox_def"
                    android:editable="false"
                    android:gravity="center"
                    android:imeOptions="actionGo"
                    android:inputType="number"
                    android:longClickable="false"
                    android:singleLine="true"
                    android:textAllCaps="true"
                    android:textColor="#000000"
                    android:textSize="16sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/LLArticleTag"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_gravity="center"
                android:layout_marginLeft="3dp"
                android:gravity="left|center_vertical"
                android:orientation="horizontal"
                android:visibility="visible"
                android:weightSum="4">

                <Button
                    android:id="@+id/btnScanTag"
                    android:layout_width="0dp"
                    android:layout_height="fill_parent"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_normal_style"
                    android:gravity="center"
                    android:text="@string/buttontext_scanLabelTag"
                    android:textColor="#ffffffff"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/txtLabelTagVal"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="3dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginRight="3dp"
                    android:layout_marginBottom="1dp"
                    android:layout_weight="2"
                    android:background="@drawable/txtbox_def"
                    android:editable="false"
                    android:gravity="center"
                    android:imeOptions="actionGo"
                    android:inputType="textCapCharacters"
                    android:longClickable="false"
                    android:singleLine="true"
                    android:textAllCaps="true"
                    android:textColor="#000000"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnUpdateLabelTag"
                    android:layout_width="0dp"
                    android:layout_height="fill_parent"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_normal_style"
                    android:gravity="center"
                    android:text="@string/buttontext_updateLabelTag"
                    android:textColor="#ffffffff"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <Button
                android:id="@+id/btnOTP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginRight="3dp"
                android:background="@drawable/button_ok_style"
                android:text="@string/buttontext_otp_not_verified"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"></Button>


            <Switch
                android:id="@+id/yesno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="2dp"
                android:layout_weight="1.5"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="visible" />

            <!--new location for textbox-->
            <LinearLayout
                android:id="@+id/LLtxtValue"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/txtValue"
                    android:layout_width="fill_parent"
                    android:layout_height="48dp"
                    android:layout_marginRight="3dp"
                    android:background="@drawable/txtbox_def"
                    android:focusable="true"
                    android:gravity="center"
                    android:imeOptions="actionDone"
                    android:inputType="textCapCharacters"
                    android:minWidth="100dp"
                    android:minHeight="48dp"
                    android:singleLine="true"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:visibility="visible" />

                <EditText
                    android:id="@+id/txtValue2"
                    android:layout_width="fill_parent"
                    android:layout_height="48dp"
                    android:layout_marginRight="3dp"
                    android:background="@drawable/txtbox_def"
                    android:focusable="true"
                    android:gravity="center"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:minWidth="100dp"
                    android:minHeight="48dp"
                    android:singleLine="true"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/lbldegc"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginRight="2dp"
                    android:layout_marginBottom="2dp"
                    android:gravity="center"
                    android:text="@string/degc"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/lbltempTS"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="25dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginRight="2dp"
                    android:layout_marginBottom="2dp"
                    android:gravity="center"
                    android:text=""
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!--new location for LLPhoto-->
            <LinearLayout
                android:id="@+id/LLPhoto"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_gravity="center"
                android:gravity="left"
                android:orientation="horizontal"
                android:visibility="visible"
                android:weightSum="5">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="fill_parent"
                    android:layout_weight="3"
                    android:gravity="right|center_vertical">

                    <TextView
                        android:id="@+id/lblphotorequiredlabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lblphotorequired"
                        android:textSize="16sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="fill_parent"
                    android:layout_weight="0.5"
                    android:gravity="right|center_vertical">

                    <CheckBox
                        android:id="@+id/cbPhoto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/menu_bg"
                        android:enabled="false"
                        android:text=""
                        android:textSize="16sp"
                        android:visibility="visible" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="fill_parent"
                    android:layout_weight="0.75"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:id="@+id/imgPhoto"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:src="@mipmap/ic_action_camera_alt_enabled"
                        android:visibility="visible" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="fill_parent"
                    android:layout_weight="0.75"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:id="@+id/imgCancelPhoto"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:src="@mipmap/ic_action_collections" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>