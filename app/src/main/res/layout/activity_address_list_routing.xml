<LinearLayout android:id="@+id/AddressListlinearLayout1"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:weightSum="10"
    android:background="#ffffffff">

    <LinearLayout
        android:id="@+id/AddressListUnreadMsgLinearLayout"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="top"
        android:background="@color/colorPrimaryDark"
        android:weightSum="1"
        android:orientation="horizontal">
        <Button
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="1.0"
            android:text="@string/buttontext_unreadmsg"
            android:id="@+id/AddressListUnreadMsgtextBtn"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:gravity="center"
            android:textStyle="bold"
            android:background="@drawable/button_fail_style"
            android:layout_margin="5dp"
            android:onClick="AddressListRoutingUnreadMsgtextClick"
            />
    </LinearLayout>

