<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/Dashboard2linearLayout1"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/colorPrimaryDark"
    android:orientation="vertical"
    android:weightSum="10">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-10dp"
        android:layout_weight="1"
        android:background="@color/colorPrimaryDark">

    </LinearLayout>

    <LinearLayout
        android:id="@+id/Dashboard2UnreadMsgLinearLayout"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:layout_weight="1"
        android:background="@color/colorPrimaryDark"
        android:orientation="horizontal"
        android:weightSum="1">

        <Button
            android:id="@+id/Dashboard2UnreadMsgtextBtn"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_margin="5dp"
            android:layout_weight="1.0"
            android:background="@drawable/button_fail_style"
            android:gravity="center"
            android:onClick="Dashboard2UnreadMsgtextClick"
            android:text="@string/buttontext_unreadmsg"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#ffffffff"
        android:visibility="gone"
        android:weightSum="3">

        <TextView
            android:id="@+id/Dashboard2text"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_marginLeft="5dp"
            android:layout_weight="1.0"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:gravity="left|center"
            android:minLines="1"
            android:singleLine="false"
            android:text="CN No."
            android:textColor="#ffff0000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/txtDashboard2Input"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_margin="1dp"
            android:layout_weight="2.0"
            android:background="@drawable/txtbox_def"
            android:focusable="true"
            android:imeOptions="actionGo"
            android:inputType="textCapCharacters"
            android:paddingLeft="10dp"
            android:singleLine="true"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/LLpercentage"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="1"
        android:background="@color/colorPrimaryDark"
        android:gravity="center|left"
        android:orientation="horizontal"
        android:weightSum="5">

        <LinearLayout
            android:id="@+id/LLbtnPercentage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="visible"
            android:weightSum="10">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="8">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:id="@+id/rlpercentage"
                        android:layout_width="53dp"
                        android:layout_height="53dp"
                        android:background="@drawable/rect_border_grey"
                        android:gravity="center"
                        android:padding="0dp">

                        <TextView
                            android:id="@+id/lblp"
                            android:layout_width="49dp"
                            android:layout_height="49dp"
                            android:gravity="center"
                            android:text="0\n0.0%"
                            android:textColor="#000000"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:typeface="sans"
                            android:visibility="visible"></TextView>


                        <!--<ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@mipmap/ic_action_collection" />-->

                    </RelativeLayout>

                </RelativeLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/item_dashboard2performance"
                    android:textColor="@color/White"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="visible"
            android:weightSum="10">

            <LinearLayout
                android:id="@+id/LLbtnOpen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:visibility="visible"
                    android:layout_weight="8">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:id="@+id/rlunlock"
                            android:layout_width="53dp"
                            android:layout_height="53dp"
                            android:background="@drawable/rect_border_grey"
                            android:gravity="center"
                            android:padding="0dp">

                            <TextView
                                android:id="@+id/lblunlock"
                                android:layout_width="49dp"
                                android:layout_height="49dp"
                                android:gravity="center"
                                android:text="0"
                                android:textColor="#000000"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:typeface="sans"
                                android:visibility="visible"></TextView>


                            <!--<ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@mipmap/ic_edit" />-->

                        </RelativeLayout>

                    </RelativeLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="2"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/item_dashboard2unlock"
                        android:textColor="@color/White"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="visible"
            android:weightSum="10">

            <!--<LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="8">

                <RelativeLayout
                    android:id="@+id/LLbtn3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:onClick="menu_btn_click"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:id="@+id/rl3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rect_border_grey"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@mipmap/ic_action_collection" />

                    </RelativeLayout>

                </RelativeLayout>

            </LinearLayout>-->

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llhidden1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="visible"
            android:weightSum="10">

            <!--<LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="8">

                <RelativeLayout
                    android:id="@+id/LLbtn4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:id="@+id/rl4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rect_border_grey"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@mipmap/ic_action_collection" />

                    </RelativeLayout>

                </RelativeLayout>

            </LinearLayout>-->

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llhidden2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            android:weightSum="10">

            <!--<LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="8">

                <RelativeLayout
                    android:id="@+id/LLbtn5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:id="@+id/rl5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rect_border_grey"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@mipmap/ic_action_collection" />

                    </RelativeLayout>

                </RelativeLayout>

            </LinearLayout>-->

        </LinearLayout>

        <TextView
            android:id="@+id/lblpercentage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:layout_weight="4"
            android:text="percentage"
            android:textColor="#ffffff"
            android:textSize="16sp"
            android:textStyle="bold"
            android:typeface="sans"
            android:visibility="gone"></TextView>

        <LinearLayout
            android:id="@+id/llptpie"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@mipmap/pie00"
            android:gravity="center"
            android:visibility="visible">

            <TextView
                android:id="@+id/lblpoint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:text="0.0"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:textStyle="bold"
                android:typeface="sans"></TextView>


        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/LLEdit"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="0.8"
        android:background="@color/colorPrimaryDark"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="4">

        <Button
            android:id="@+id/btnResetRoute"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_margin="5dp"
            android:layout_weight="1.25"
            android:background="@drawable/button_edit_style"
            android:gravity="center"
            android:onClick="btnResetRoute_Click"
            android:text="@string/lbl_resetroutetxt"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnCancelUpdateRoute"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_margin="5dp"
            android:layout_weight="1.25"
            android:background="@drawable/button_fail_style"
            android:gravity="center"
            android:onClick="btnCancelUpdateRoute_Click"
            android:text="@string/buttontext_cancel"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnUpdateRoute"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_margin="5dp"
            android:layout_weight="1.25"
            android:background="@drawable/button_update_style"
            android:gravity="center"
            android:onClick="btnUpdateRoute_Click"
            android:text="@string/lbl_updatetxt"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnEditRoute"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_margin="5dp"
            android:layout_weight="4"
            android:background="@drawable/button_edit_style"
            android:gravity="center"
            android:onClick="btnEditRoute_Click"
            android:text="@string/lbl_editroutetxt"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/Dashboard2ListviewLinearLayout"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:layout_marginTop="0dp"
        android:layout_weight="7.2"
        android:background="@color/colorPrimaryDark"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="80dp"
            android:background="@color/brightergreen"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true" />

    </LinearLayout>

</LinearLayout>