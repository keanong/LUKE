<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/linearLayout1"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#ffe4f4ff"
    android:orientation="vertical"
    android:weightSum="10">

    <LinearLayout
        android:id="@+id/LLsignbelowlbl"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:layout_marginBottom="2dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1.5"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/lblsignbelow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/ack_rec_inorder"
            android:textColor="#040404"
            android:textSize="14sp"
            android:textStyle="bold" />
        <!--<TextView
            android:id="@+id/lblsignbelow"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:gravity="center|top"
            android:text="@string/lbl_signbelow"
            android:textAllCaps="true"
            android:textColor="#040404"
            android:textSize="16sp"
            android:textStyle="bold" />-->
    </LinearLayout>

    <LinearLayout
        android:id="@+id/LLSignPad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:layout_marginBottom="2dp"
        android:layout_marginLeft="1dp"
        android:layout_marginRight="1dp"
        android:layout_marginTop="2dp"
        android:layout_weight="4.5"
        android:background="#ffffff"
        android:orientation="vertical"
        android:visibility="visible" />

    <LinearLayout
        android:id="@+id/LLSignPadView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:layout_marginBottom="2dp"
        android:layout_marginLeft="1dp"
        android:layout_marginRight="1dp"
        android:layout_marginTop="2dp"
        android:layout_weight="4.5"
        android:background="#ffffff"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/viewSignature"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/LLreceiverNamelbl"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:layout_marginBottom="2dp"
        android:layout_marginTop="2dp"
        android:layout_weight="0.5"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/lblname"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:gravity="center"
            android:text="@string/lbl_entername"
            android:textAllCaps="true"
            android:textColor="#040404"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/LLreceiverNametxt"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:layout_marginBottom="2dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:background="#ffffff"
        android:orientation="vertical"
        android:visibility="visible">

        <EditText
            android:id="@+id/txtReceiverName"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_margin="1dp"
            android:background="@drawable/txtbox_def"
            android:focusable="true"
            android:gravity="center"
            android:hint="@string/hintentername"
            android:imeOptions="actionDone"
            android:inputType="textCapCharacters"
            android:singleLine="true"
            android:textSize="20sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/LLhidden"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:layout_marginBottom="2dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1.5"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

    </LinearLayout>

    <LinearLayout
        android:id="@+id/LLStaffIDlbl"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:layout_marginBottom="2dp"
        android:layout_marginTop="2dp"
        android:layout_weight="0.4"
        android:background="#ffe4f4ff"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/lblStaffIDTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/lbl_enterstaffid"
            android:textAllCaps="true"
            android:textColor="#040404"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/LLStaffIDtxt"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:layout_marginBottom="2dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:background="#ffe4f4ff"
        android:orientation="vertical"
        android:visibility="visible">

        <EditText
            android:id="@+id/txtStaffID"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_margin="1dp"
            android:background="@drawable/txtbox_def"
            android:focusable="true"
            android:gravity="center"
            android:hint="@string/hintenterstaffid"
            android:imeOptions="actionDone"
            android:inputType="textCapCharacters"
            android:singleLine="true"
            android:textSize="20sp"
            android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/LLblank"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:layout_marginBottom="2dp"
        android:layout_marginTop="2dp"
        android:layout_weight="0.1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

    </LinearLayout>

    <LinearLayout
        android:id="@+id/LLbuttons"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:layout_weight="1"
        android:background="#ffe4f4ff"
        android:orientation="horizontal"
        android:weightSum="3">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_gravity="top"
            android:layout_margin="1dp"
            android:layout_weight="1"
            android:background="@drawable/button_normal_style"
            android:onClick="CancelsetSignatureName"
            android:text="@string/buttontext_cancel"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_gravity="top"
            android:layout_margin="1dp"
            android:layout_weight="1"
            android:background="@drawable/button_normal_style"
            android:onClick="clearSignature"
            android:text="@string/buttontext_clear"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_gravity="top"
            android:layout_margin="1dp"
            android:layout_weight="1"
            android:background="@drawable/button_normal_style"
            android:onClick="btnOKClick2"
            android:text="@string/buttontext_ok"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
