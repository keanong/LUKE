<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="50dp"
    android:background="@drawable/list_selector"
    android:gravity="top"
    android:weightSum="5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="5">

        <TextView
            android:id="@+id/lblListHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingLeft="?android:attr/expandableListPreferredItemPaddingLeft"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="Group Title"
            android:textAllCaps="true"
            android:textColor="#000000"
            android:layout_weight="3.3"/>

        <LinearLayout
            android:id="@+id/LLjobs_list_group_ihavearrive"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.7"
            android:gravity="center">

            <ImageView
                android:id="@+id/img_i_have_arrive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@mipmap/ic_action_i_arr"/>
        </LinearLayout>

        <TextView
            android:id="@+id/lblListHeaderCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingRight="20dp"
            android:textSize="28sp"
            android:textStyle="bold"
            android:text="0"
            android:textAllCaps="true"
            android:textColor="#0026ff"
            android:layout_weight="1"
            android:gravity="right" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/LLarrival"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">
        <TextView
            android:id="@+id/lblarrival"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="?android:attr/expandableListPreferredItemPaddingLeft"
            android:text="arrival timing"
            android:textColor="#000000"
            android:layout_marginBottom="2dp"/>
    </LinearLayout>

</LinearLayout>
