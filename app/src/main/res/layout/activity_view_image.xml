<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:id="@+id/linearLayout1"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical" xmlns:android="http://schemas.android.com/apk/res/android"
    android:weightSum="10">
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="9"
        android:layout_gravity="top"
        android:background="#ffe4f4ff">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/lblimgPathIDX"
            android:visibility="gone"/>
        <ImageView
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:id="@+id/preview"
            android:adjustViewBounds="true"
            android:background="@android:color/black"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#ffe4f4ff"
        android:layout_marginTop="1dp">

        <Button
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:text="@string/buttontext_back"
            android:id="@+id/btnViewImageBack"
            android:onClick="btnViewImageBackClick"
            android:textStyle="bold"
            android:layout_weight="1"
            android:focusable="false"
            android:textColor="#ffffff"
            android:background="@drawable/button_normal_style"
            android:textSize="18sp"
            android:layout_margin="1dp" />
        <Button
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:text="@string/buttontext_delete"
            android:id="@+id/btnViewImageDiscard"
            android:onClick="btnViewImageDiscardClick"
            android:textStyle="bold"
            android:layout_weight="1"
            android:focusable="false"
            android:textColor="#ffffff"
            android:background="@drawable/button_normal_style"
            android:textSize="18sp"
            android:layout_margin="1dp" />

        <!--<Button
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:text="@string/buttontext_back"
            android:id="@+id/btnViewImageBack"
            android:onClick="btnViewImageBackClick"
