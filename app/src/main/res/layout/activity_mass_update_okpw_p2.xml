<LinearLayout android:id="@+id/MassUpdateOKPwP2linearLayout1"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:weightSum="10"
    android:background="#ffffffff">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="9"
        android:layout_gravity="top"
        android:background="#ffffff"
        android:orientation="horizontal">

        <TextView android:id="@+id/lblIsDefaultVRPpage"
            android:layout_height="2dp"
            android:layout_width="2dp"
            android:visibility="gone"></TextView>

        <ListView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:id="@+id/MassOKPwP2listView"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:choiceMode="singleChoice"
            android:clickable="true"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:layout_weight="1"
        android:background="#ffffff"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnMassOKPwP2Cancel"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_margin="1dp"
            android:layout_weight="1"
            android:background="@drawable/button_normal_style"
            android:onClick="btnCancelClick"
            android:text="@string/buttontext_back"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMassOKPwP2Submit"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_margin="1dp"
            android:layout_weight="1"
            android:background="@drawable/button_normal_style"
            android:onClick="btnSubmitClick2"
            android:text="@string/buttontext_submit"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!--<Button
            android:id="@+id/btnMassOKPwP2Cancel"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:text="@string/buttontext_back"
            android:layout_weight="1"
            android:onClick="btnCancelClick"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:background="@color/menu_bg"
            android:layout_marginRight="0.5dp"
            android:layout_marginLeft="1dp" />

        <Button
            android:id="@+id/btnMassOKPwP2Submit"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:text="@string/buttontext_submit"
            android:layout_weight="1"
            android:onClick="btnSubmitClick2"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:background="@color/menu_bg"
            android:layout_marginRight="0.5dp"
            android:layout_marginLeft="1dp" />-->

    </LinearLayout>
</LinearLayout>