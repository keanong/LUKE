<?xml version="1.0" encoding="utf-8"?><!--<android.support.design.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:weightSum="10">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/colorPrimaryDark"
                android:gravity="left"
                android:weightSum="5"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lblSelectText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingLeft="5dp"
                    android:paddingTop="10dp"
                    android:paddingRight="5dp"
                    android:paddingBottom="10dp"
                    android:background="@color/colorPrimaryDark"
                    android:text="@string/vrpunlocktap"
                    android:textColor="@color/White"
                    android:textSize="16sp"
                    android:textStyle="bold" />


                <!--<LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@color/White"
                    android:layout_weight="5"
                    android:gravity="center">

                </LinearLayout>-->


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="8"
                android:background="@color/White"
                android:gravity="left"
                android:weightSum="10"
                android:orientation="vertical">

                <ListView
                    android:id="@+id/listView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="10"
                    android:layout_marginLeft="1dp"
                    android:layout_marginRight="1dp"
                    android:choiceMode="singleChoice"
                    android:clickable="false"
                    android:descendantFocusability="beforeDescendants" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/White"
                android:gravity="left"
                android:weightSum="2"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnvrpunlock_dialogCancel"
                    android:layout_width="0dp"
                    android:layout_height="fill_parent"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_normal_style"
                    android:gravity="center"
                    android:onClick="btnCODupdate2Cancel_Click"
                    android:text="@string/buttontext_cancel"
                    android:textColor="#ffffff"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="visible" />

                <Button
                    android:id="@+id/btnvrpunlock_dialogNext"
                    android:layout_width="0dp"
                    android:layout_height="fill_parent"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_normal_style"
                    android:gravity="center"
                    android:text="@string/buttontext_ok"
                    android:textColor="#ffffff"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="visible" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>

