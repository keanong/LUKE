<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/linearLayout1"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical" xmlns:android="http://schemas.android.com/apk/res/android"
    android:weightSum="10"
    android:background="#ffffffff">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="top"
        android:background="#ffffffff"
        android:weightSum="2">

        <TextView android:id="@+id/lblIsDefaultVRPpage"
            android:layout_height="2dp"
            android:layout_width="2dp"
            android:visibility="gone"></TextView>

        <Button
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:text="@string/item_dashboard2PIP"
            android:id="@+id/btnJRPUtoggle"
            android:onClick="btnJRPUClick"
            android:textStyle="bold"
            android:layout_weight="1"
            android:focusable="false"
            android:background="@drawable/button_ok_style"
            android:textColor="#000000"
            android:textSize="18sp"
            android:layout_margin="1dp" />

        <Button
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:text="@string/item_dashboard2DIP"
            android:id="@+id/btnJRDIPtoggle"
            android:onClick="btnJRDIPClick"
            android:textStyle="bold"
            android:layout_weight="1"
            android:focusable="false"
            android:background="@drawable/button_disabled_style"
            android:textColor="#000000"
            android:textSize="18sp"
            android:layout_margin="1dp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:layout_gravity="top"
        android:background="#84d8ff">

        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:id="@+id/lbljrAddress"
            android:layout_margin="1dp"
            android:text="@string/lblADDRESS2"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:gravity="center"
            android:textColor="#000000"
            />
    </LinearLayout>

