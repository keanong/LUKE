    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5"
        android:layout_gravity="center"
        android:gravity="center"
        android:background="#ffffffff"
        android:weightSum="3"
        android:layout_margin="1dp">

        <TextView
            android:id="@+id/lblpufmdelto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="pu from or del to"
            android:textAllCaps="true"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5"
        android:gravity="center"
        android:background="#ffffffff"
        android:weightSum="3"
        android:layout_margin="1dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="@string/lbljrtotal"
            android:id="@+id/lbljrtotaljobs"
            android:textSize="16sp"
            android:textColor="#040404"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:focusable="false"
            android:layout_marginLeft="10dp"
            android:layout_marginBottom="1dp"
            android:layout_marginTop="1dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="0"
            android:id="@+id/lbljrTotaljobs"
            android:textSize="16sp"
            android:textColor="#ffff0000"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:focusable="false"
            android:layout_marginLeft="5dp"
            android:layout_marginBottom="1dp"
            android:layout_marginTop="1dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="@string/lbljrtotalbags"
            android:id="@+id/lbljrtotalbags"
            android:textSize="14sp"
            android:textColor="#040404"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:focusable="false"
            android:layout_marginLeft="10dp"
            android:layout_marginBottom="1dp"
            android:layout_marginTop="1dp"
            android:visibility="gone"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="0"
            android:id="@+id/lbljrTotalbagsentered"
            android:textSize="14sp"
            android:textColor="#ffff0000"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:focusable="false"
            android:layout_marginLeft="5dp"
            android:layout_marginBottom="1dp"
            android:layout_marginTop="1dp"
            android:visibility="gone"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="/"
            android:id="@+id/lbljrTotalbagsdivider"
            android:textSize="14sp"
            android:textColor="#ffff0000"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:focusable="false"
            android:layout_marginLeft="5dp"
            android:layout_marginBottom="1dp"
            android:layout_marginTop="1dp"
            android:visibility="gone"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="0"
            android:id="@+id/lbljrTotalbags"
            android:textSize="14sp"
            android:textColor="#ffff0000"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:focusable="false"
            android:layout_marginLeft="5dp"
            android:layout_marginBottom="1dp"
            android:layout_marginTop="1dp"
            android:visibility="gone"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="6.5"
        android:layout_gravity="top"
        android:background="#ffffffff"
        android:weightSum="3"
        android:layout_margin="1dp">

        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:focusable="false"
            android:focusableInTouchMode="true">
            <ListView
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:id="@+id/listView"
                android:choiceMode="singleChoice"
                android:clickable="true"
                android:focusable="false"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true" />
        </RelativeLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#ffffffff"
        android:visibility="gone"
        android:weightSum="2">

        <Button
            android:id="@+id/btnJRfail"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_margin="1dp"
            android:layout_weight="1"
            android:background="@drawable/button_fail_style"
            android:gravity="center"
            android:onClick="btnjrFAILclick"
            android:text="@string/buttontext_fail"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnJRpu"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_margin="1dp"
            android:layout_weight="2"
            android:background="@drawable/button_ok_style"
            android:gravity="center"
            android:onClick="btnjrPUclick"
            android:text="@string/buttontext_pu"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnJRokp"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_margin="1dp"
            android:layout_weight="2"
            android:background="@drawable/button_ok_style"
            android:gravity="center"
            android:onClick="btnjrOKPclick"
            android:text="@string/buttontext_okp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="18sp"
            android:visibility="gone" />

    </LinearLayout>
</LinearLayout>