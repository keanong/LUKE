<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#ffffffff"
    android:orientation="vertical"
    android:weightSum="10"
    tools:context="com.xdel.luke.CODupdate">

    <LinearLayout
        android:id="@+id/LLTotal"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_above="@+id/LLButton"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="4">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="2"
            android:background="#ff0000"
            android:gravity="center_vertical"
            android:weightSum="2">

            <TextView
                android:id="@+id/lblTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:text="@string/paymentmode_total"
                android:textColor="#ffffff"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblTotalVal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:text="0.00"
                android:textColor="#ffffff"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="2"
            android:background="#ff0000"
            android:gravity="center_vertical"
            android:weightSum="2">

            <TextView
                android:id="@+id/lblBalnace"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:text="@string/paymentmode_balance"
                android:textColor="#ffffff"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblBalanceVal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:text="$0.00"
                android:textColor="#ffffff"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>


    </LinearLayout>

    <LinearLayout
        android:id="@+id/LLsubmission"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="8"
        android:background="#ffffff"
        android:orientation="vertical">

        <ListView
            android:id="@+id/listView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:choiceMode="singleChoice"
            android:clickable="false"
            android:descendantFocusability="beforeDescendants" />


    </LinearLayout>

    <LinearLayout
        android:id="@+id/LLButton"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignParentBottom="true"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnDOCODupdateCANCEL"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_gravity="top"
            android:layout_margin="1dp"
            android:layout_weight="1"
            android:background="@drawable/button_normal_style"
            android:focusable="false"
            android:onClick="CancelsetDeliveredStatus"
            android:text="@string/buttontext_cancel"
            android:textSize="18sp"
            android:textColor="#ffffff"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDOCODupdateNext"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_gravity="top"
            android:layout_margin="1dp"
            android:layout_weight="1"
            android:background="@drawable/button_normal_style"
            android:focusable="false"
            android:onClick="btnNextClick"
            android:text="@string/buttontext_next"
            android:textSize="18sp"
            android:textColor="#ffffff"
            android:textStyle="bold" />

        <!--<Button
            android:id="@+id/btnDOCODupdateCANCEL"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_gravity="top"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="0.5dp"
            android:layout_weight="1"
            android:background="@color/menu_bg"
            android:focusable="false"
            android:onClick="CancelsetDeliveredStatus"
            android:text="@string/buttontext_cancel"
            android:textColor="#ffffff"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDOCODupdateNext"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_gravity="top"
            android:layout_marginLeft="0.5dp"
            android:layout_marginRight="1dp"
            android:layout_weight="1"
            android:background="@color/menu_bg"
            android:focusable="false"
            android:onClick="btnNextClick"
            android:text="@string/buttontext_next"
            android:textColor="#ffffff"
            android:textStyle="bold" />-->

    </LinearLayout>

</LinearLayout>