<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:layout_marginLeft="1dp"
    android:layout_marginTop="1dp"
    android:layout_marginRight="1dp"
    android:layout_marginBottom="1dp"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:weightSum="10"
    tools:context=".PieceByPiecePU.StartQueryActivity">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:layout_margin="1dp"
        android:layout_weight="1"
        android:background="#ffffffff"
        android:weightSum="3">

        <TextView
            android:id="@+id/lblIsDefaultVRPpage"
            android:layout_width="2dp"
            android:layout_height="2dp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/txtBarcodeMANUALENTRY"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="2dp"
            android:layout_weight="2"
            android:background="@drawable/txtbox_def"
            android:focusable="true"
            android:gravity="center"
            android:imeOptions="actionGo"
            android:inputType="textCapCharacters"
            android:singleLine="true"
            android:textSize="16sp"
            android:textStyle="bold"></EditText>

        <Button
            android:id="@+id/btnBarcodeSubmitENTER"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="2dp"
            android:layout_weight="1"
            android:background="@drawable/button_normal_style"
            android:focusable="false"
            android:onClick="btnBarcodeSubmitENTER_Click"
            android:text="@string/buttontext_enter"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/LLMPDMainShown"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:layout_margin="1dp"
        android:layout_weight="8"
        android:background="#ffffffff"
        android:orientation="vertical"
        android:visibility="visible"
        android:weightSum="8">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:layout_weight="8"
            android:background="#ffffffff"
            android:orientation="vertical">

            <ExpandableListView
                android:id="@+id/expListView"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:choiceMode="singleChoice"
                android:clickable="true"
                android:transcriptMode="disabled" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:layout_margin="1dp"
        android:layout_weight="1"
        android:background="#ffffffff"
        android:weightSum="3">

        <Button
            android:id="@+id/btnCX"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_margin="1dp"
            android:layout_weight="1.5"
            android:background="@drawable/button_normal_style"
            android:focusable="false"
            android:text="@string/buttontext_cancel"
            android:textColor="#ffffff"
            android:onClick="btnCX_Click"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPU"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_gravity="top"
            android:layout_margin="1dp"
            android:layout_weight="1.5"
            android:background="@drawable/button_normal_style"
            android:focusable="false"
            android:text="@string/buttontext_PU"
            android:onClick="btnPU_Click"
            android:visibility="visible"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>