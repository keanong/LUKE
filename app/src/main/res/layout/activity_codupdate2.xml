<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#ffffff"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:weightSum="10"
    tools:context=".DOCOD.CODupdate2">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:layout_weight="1"
        android:background="@color/colorPrimaryDark"
        android:gravity="center"
        android:weightSum="3">

        <TextView
            android:id="@+id/text"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_marginLeft="5dp"
            android:layout_weight="1.0"
            android:gravity="left|center"
            android:minLines="1"
            android:singleLine="false"
            android:text="CN No."
            android:textColor="#ffffff"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/txtInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_margin="1dp"
            android:layout_marginTop="1dp"
            android:layout_weight="2.0"
            android:background="@drawable/txtbox_def"
            android:focusable="true"
            android:imeOptions="actionGo"
            android:inputType="textCapCharacters"
            android:paddingLeft="10dp"
            android:singleLine="true"
            android:drawableRight="@mipmap/ic_search"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/LLTotal"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_above="@+id/LLButton"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="4">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="2"
            android:background="@color/colorPrimaryDark"
            android:gravity="center_vertical"
            android:weightSum="2">

            <TextView
                android:id="@+id/lblTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:text="@string/paymentmode_total"
                android:textColor="#ffffff"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblTotalVal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:text="0.00"
                android:textColor="#ffffff"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="2"
            android:background="@color/colorPrimaryDark"
            android:gravity="center_vertical"
            android:weightSum="2">

            <TextView
                android:id="@+id/lblBalnace"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:text="@string/paymentmode_balance"
                android:textColor="#ffffff"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblBalanceVal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:text="$0.00"
                android:textColor="#ffffff"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>


    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:layout_marginTop="1dp"
        android:layout_weight="8"
        android:background="#ffffff"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:orientation="vertical"
        android:weightSum="9">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_weight="8">

            <ExpandableListView
                android:id="@+id/expListView"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:choiceMode="singleChoice"
                android:clickable="true"
                android:transcriptMode="disabled" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnCODupdate2Cancel"
                android:layout_width="0dp"
                android:layout_height="fill_parent"
                android:layout_margin="1dp"
                android:layout_weight="1"
                android:background="@drawable/button_normal_style"
                android:gravity="center"
                android:text="@string/buttontext_cancel"
                android:textColor="#ffffff"
                android:textSize="18sp"
                android:onClick="btnCODupdate2Cancel_Click"
                android:textStyle="bold"
                android:visibility="visible" />

            <Button
                android:id="@+id/btnCODupdate2Next"
                android:layout_width="0dp"
                android:layout_height="fill_parent"
                android:layout_margin="1dp"
                android:layout_weight="1"
                android:background="@drawable/button_ok_style"
                android:gravity="center"
                android:text="@string/buttontext_next"
                android:onClick="btnCODupdate2NextClick"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="visible" />

        </LinearLayout>


    </LinearLayout>

</LinearLayout>