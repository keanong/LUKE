<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:id="@+id/linearLayout1"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical" xmlns:android="http://schemas.android.com/apk/res/android"
    android:weightSum="10"
    android:background="#ffffffff">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="top"
        android:background="#ffffffff"
        android:weightSum="3">
        <TextView
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:text="@string/lblentry"
            android:id="@+id/lblIGCMANUALENTRY"
            android:layout_marginLeft="5dp"
            android:textSize="14sp"
            android:textColor="#040404"
            android:textStyle="bold"
            android:layout_weight="0.5"
            android:gravity="center_vertical"
            android:focusable="false"
            android:layout_marginRight="0.5dp"
            android:layout_gravity="center" />
        <EditText
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:id="@+id/txtIGCMANUALENTRY"
            android:singleLine="true"
            android:paddingLeft="10dp"
            android:background="@drawable/txtbox_def"
            android:textSize="16sp"
            android:gravity="bottom"
            android:textStyle="bold"
            android:layout_weight="1.5"
            android:imeOptions="actionGo"
            android:inputType="textCapCharacters"
            android:focusable="true"
            android:layout_marginTop="1dp"
            android:layout_marginLeft="0.5dp"
            android:layout_marginRight="0.5dp"
            android:layout_marginBottom="1dp"
            android:layout_gravity="center">
        </EditText>

        <Button
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:text="@string/buttontext_enter"
            android:id="@+id/btnIGCENTER"
            android:layout_weight="1"
            android:textStyle="bold"
            android:focusable="false"
            android:onClick="btnIGCENTERClick"
            android:textColor="#ffffff"
            android:background="@drawable/button_normal_style"
            android:layout_margin="1dp"
            android:textSize="18sp"
            android:layout_gravity="center" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#ffffffff"
        android:weightSum="3"
        android:gravity="right"
        android:layout_gravity="top">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/lblenrty1"
            android:id="@+id/lblIGCentry1"
            android:layout_marginLeft="5dp"
            android:textSize="14sp"
            android:textColor="#040404"
            android:textStyle="bold"
            android:focusable="false"
            android:gravity="center_vertical"
            android:layout_weight="0.5"
            android:layout_gravity="center" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:id="@+id/lblIGCenrty1val"
            android:layout_marginRight="1dp"
            android:textSize="14sp"
            android:textColor="#040404"
            android:textStyle="bold"
            android:focusable="false"
            android:gravity="center_vertical"
            android:layout_weight="2.5"
            android:layout_gravity="center" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5"
        android:background="#ffffffff"
        android:weightSum="3"
        android:layout_gravity="center"
        android:gravity="center_vertical|center_horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_clickabovetodelete"
            android:id="@+id/lblJobsheetSubmitMISC"
            android:layout_marginRight="1dp"
            android:textSize="12sp"
            android:textColor="#ffff0000"
            android:textStyle="bold"
            android:focusable="false"
            android:gravity="center_vertical"
            android:layout_gravity="center" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="6.5"
        android:layout_gravity="top"
        android:background="#ffffffff"
        android:weightSum="3"
        android:layout_marginTop="2dp">

        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:focusableInTouchMode="true"
            android:focusable="false">
            <ListView
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:id="@+id/listView"
                android:choiceMode="singleChoice"
                android:clickable="true"
                android:focusable="false"/>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="top"
        android:background="#ffffffff"
        android:weightSum="3">

        <Button
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:text="@string/buttontext_cancel"
            android:id="@+id/btnIGCCANCEL"
            android:onClick="btnIGCCANCELClick"
            android:textStyle="bold"
            android:layout_weight="1.5"
            android:focusable="false"
            android:textColor="#ffffff"
            android:background="@drawable/button_normal_style"
            android:layout_margin="1dp"
            android:textSize="18sp"
            android:layout_gravity="top" />

        <Button
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:text="@string/buttontext_reset"
            android:id="@+id/btnIGCRESET"
            android:onClick="btnIGCRESETClick"
            android:textStyle="bold"
            android:layout_weight="1.5"
            android:focusable="false"
            android:layout_margin="1dp"
            android:textColor="#ffffff"
            android:background="@drawable/button_normal_style"
            android:textSize="18sp"
            android:layout_gravity="top" />
    </LinearLayout>
</LinearLayout>
