            android:layout_height="fill_parent"
            android:text="@string/buttontext_cleardata"
            android:id="@+id/btnCreditCardCLEARALL"
            android:layout_weight="1"
            android:textStyle="bold"
            android:focusable="false"
            android:onClick="btnCreditCardCLEARALLClick"
            android:background="@color/menu_bg"
            android:textColor="#ffffff"
            android:layout_marginRight="0.5dp"
            android:layout_marginLeft="0.5dp" />
        <Button
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:text="@string/buttontext_submit"
            android:id="@+id/btnCreditCardSUBMIT"
            android:textStyle="bold"
            android:layout_weight="1"
            android:focusable="false"
            android:onClick="btnCreditCardSUBMITClick"
            android:background="@color/menu_bg"
            android:textColor="#ffffff"
            android:layout_marginRight="1dp"
            android:layout_marginLeft="0.5dp" />-->
    </LinearLayout>
</LinearLayout>
