<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:id="@+id/linearLayout1"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="50dp"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/list_selector_white"
    android:weightSum="2">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/lblMassOKPwP2JobNo"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="Job #"
            android:layout_marginLeft="5dp"
            android:textColor="#ffff0000"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:gravity="left|center"
            />
        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:id="@+id/lblPart1JobsIDX"
            android:visibility="gone"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:id="@+id/lblPart2JobsIDX"
            android:visibility="gone"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:id="@+id/lblPart2StatusCodesIDX"
            android:visibility="gone"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:id="@+id/lblPart2Part2ImageString"
            android:visibility="gone"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:id="@+id/lblPart2Part2FailureReason"
            android:visibility="gone"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="0.9"
        android:weightSum="4"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgVMassOKPwP2Status"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:src="@mipmap/ic_action_unknownblue"
            android:layout_marginTop="0.5dp"
            android:layout_marginRight="0.5dp"
            android:layout_marginBottom="0.5dp"
            android:layout_marginLeft="1dp"
            android:background="@drawable/button_normal_style"/>
        <Button
            android:id="@+id/btnMassOKPwP2PU"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:layout_marginTop="0.5dp"
            android:layout_marginRight="0.5dp"
            android:layout_marginBottom="0.5dp"
            android:layout_marginLeft="1dp"
            android:text="PU"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:background="@drawable/button_normal_style"
            android:textColor="#ffffff"/>
        <Button
            android:id="@+id/btnMassOKPwP2FailPU"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:layout_marginTop="0.5dp"
            android:layout_marginRight="1dp"
            android:layout_marginBottom="0.5dp"
            android:layout_marginLeft="0.5dp"
            android:text="FAIL"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:background="@drawable/button_normal_style"
            android:textColor="#ffffff"/>
        <ImageButton
            android:id="@+id/btnMassOKPwP2Refresh"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:layout_marginTop="0.5dp"
            android:layout_marginRight="1dp"
            android:layout_marginBottom="0.5dp"
            android:layout_marginLeft="0dp"
            android:background="@drawable/button_normal_style"
            android:src="@mipmap/ic_action_refresh"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="0.1"
        android:layout_gravity="top"
        android:layout_marginTop="1dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/v3"
            android:layout_width="fill_parent"
            android:layout_height="2dp"
            android:layout_below="@+id/lblAddress1"
            android:background="#ff000000"></View>

    </LinearLayout>

</LinearLayout>