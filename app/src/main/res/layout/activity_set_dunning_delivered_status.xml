<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/linearLayout1"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#ffffffff"
    android:orientation="vertical"
    android:weightSum="10">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:layout_marginLeft="1dp"
        android:layout_marginRight="1dp"
        android:layout_weight="1"
        android:background="#ffffffff"
        android:orientation="vertical">

        <TextView android:id="@+id/lblIsDefaultVRPpage"
            android:layout_height="2dp"
            android:layout_width="2dp"
            android:visibility="gone"></TextView>

        <TextView
            android:id="@+id/lblJobNo"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:textAllCaps="true"
            android:textColor="#040404"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:layout_weight="1"
        android:background="#ffffffff"
        android:gravity="center">

        <RadioGroup
            android:id="@+id/rg1"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb1"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:layout_gravity="center"
                android:layout_weight="0.13"
                android:checked="false"
                android:onClick="onRadioButtonClicked"
                android:text="@string/dunning_MainOptiondocuRxBy"
                android:textColor="#ffffff"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rb2"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:layout_gravity="center"
                android:layout_weight="0.13"
                android:checked="false"
                android:onClick="onRadioButtonClicked"
                android:text="@string/dunning_MainOptionSlotted"
                android:textColor="#ffffff"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rb3"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:layout_gravity="center"
                android:layout_weight="0.13"
                android:checked="false"
                android:onClick="onRadioButtonClicked"
                android:text="@string/dunning_MainOptionnotdelivered"
                android:textColor="#ffffff"
                android:textSize="16sp" />
        </RadioGroup>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:layout_marginLeft="1dp"
        android:layout_marginRight="1dp"
        android:layout_weight="0.5"
        android:background="#ffe4f4ff"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:gravity="center"
            android:text="@string/dunning_docuRxBylbl"
            android:textAllCaps="true"
            android:textColor="#040404"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:layout_weight="1"
        android:background="#ffffffff">

        <Spinner
            android:id="@+id/ddlReceiver"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_gravity="center"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_weight="1.75"
            android:gravity="center"
            android:paddingLeft="5dp"
            android:prompt="@string/receiver_prompt" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:layout_marginLeft="1dp"
        android:layout_marginRight="1dp"
        android:layout_weight="0.5"
        android:background="#ffe4f4ff"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textView4"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:gravity="center"
            android:text="@string/dunning_buildinglbl"
            android:textAllCaps="true"
            android:textColor="#040404"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:layout_weight="1"
        android:background="#ffffffff">

        <Spinner
            android:id="@+id/ddlBuilding"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_gravity="center"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_weight="1.75"
            android:gravity="center"
            android:paddingLeft="5dp"
            android:prompt="@string/receiver_prompt" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:layout_weight="0.5"
        android:background="#ffe4f4ff"
        android:gravity="center">

        <TextView
            android:id="@+id/textView5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/lbl_remarks"
            android:textAllCaps="true"
            android:textColor="#040404"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:layout_weight="1.5"
        android:background="#ffe4f4ff">

        <EditText
            android:id="@+id/txtRemarks"
            android:layout_width="fill_parent"
            android:layout_height="match_parent"
            android:layout_margin="1dp"
            android:background="@drawable/txtbox_def"
            android:editable="false"
            android:gravity="top"
            android:hint="@string/hintenterremarks"
            android:inputType="textMultiLine"
            android:maxLines="5"
            android:minLines="5"
            android:paddingLeft="10dp"
            android:text="" />
    </LinearLayout>

    <!--<ScrollView
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:background="#ffffffff"
        android:layout_weight="4"
        android:isScrollContainer="false">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:orientation="vertical"
            android:focusableInTouchMode="true">

        </LinearLayout>

    </ScrollView>-->

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#ffe4f4ff"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSign"
            android:layout_width="fill_parent"
            android:layout_height="match_parent"
            android:layout_gravity="bottom"
            android:layout_margin="1dp"
            android:background="@drawable/button_normal_style"
            android:onClick="btnSign_Click"
            android:text="@string/buttontext_sign"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!--<Button
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:id="@+id/btnSign"
            android:text="@string/buttontext_sign"
            android:onClick="btnSign_Click"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@color/menu_bg"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="0.5dp"
            android:layout_gravity="bottom" />-->

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#ffe4f4ff"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnViewImg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="bottom"
            android:layout_margin="1dp"
            android:layout_weight="1"
            android:background="@drawable/button_normal_style"
            android:onClick="btnViewImgClick"
            android:text="@string/buttontext_browse"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCamera"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="bottom"
            android:layout_margin="1dp"
            android:layout_weight="1"
            android:background="@drawable/button_normal_style"
            android:onClick="btnCameraClick"
            android:text="@string/buttontext_cam"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!--<Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:id="@+id/btnViewImg"
            android:layout_weight="1"
            android:text="@string/buttontext_browse"
            android:onClick="btnViewImgClick"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@color/menu_bg"
            android:layout_marginLeft="0.5dp"
            android:layout_marginRight="0.5dp"
            android:layout_gravity="bottom" />

        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:id="@+id/btnCamera"
            android:layout_weight="1"
            android:text="@string/buttontext_cam"
            android:onClick="btnCameraClick"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@color/menu_bg"
            android:layout_marginRight="1dp"
            android:layout_marginLeft="0.5dp"
            android:layout_gravity="bottom" />-->
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#ffe4f4ff"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="bottom"
            android:layout_margin="1dp"
            android:layout_weight="1"
            android:background="@drawable/button_normal_style"
            android:onClick="btnCancelClicked"
            android:text="@string/buttontext_cancel"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="bottom"
            android:layout_margin="1dp"
            android:layout_weight="1"
            android:background="@drawable/button_normal_style"
            android:onClick="btnSubmitClicked"
            android:text="@string/buttontext_submit"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!--<Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="0.5dp"
            android:layout_weight="1"
            android:background="@color/menu_bg"
            android:onClick="btnCancelClicked"
            android:text="@string/buttontext_cancel"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_gravity="bottom" />

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="0.5dp"
            android:layout_marginRight="1dp"
            android:layout_weight="1"
            android:background="@color/menu_bg"
            android:onClick="btnSubmitClicked"
            android:text="@string/buttontext_submit"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_gravity="bottom" />-->
    </LinearLayout>
</LinearLayout>
